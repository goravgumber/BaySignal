DATABASE_URL=postgresql://user:password@host:5432/smartpark_db
JWT_SECRET=your_jwt_secret_minimum_32_characters
JWT_EXPIRES_IN=12h
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
MQTT_URL=mqtt://localhost:1883
# Per-device Ed25519 credentials are issued by an authorized facility manager or device technician.
# Optional compatibility only; keep disabled and set a cutoff within 30 days if migrating legacy clients.
ALLOW_LEGACY_DEVICE_API_KEY=false
LEGACY_DEVICE_API_KEY=
LEGACY_DEVICE_API_KEY_EXPIRES_AT=
DEVICE_REQUEST_WINDOW_SECONDS=300
ALLOW_SIMULATION=false
TRUST_PROXY=false
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20
